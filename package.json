    "assets:titles": "node scripts/assets/build-title-fonts.mts",
    "assets:portrait": "node scripts/assets/build-portrait.mts",
    "assets:cloud": "node scripts/assets/build-cloud.mts",
    "assets:video": "node scripts/assets/encode-videos.mts",
    "assets:ambi": "node scripts/assets/sample-ambilight.mts",
    "assets:manifest": "node scripts/assets/asset-manifest.mts",
    "assets:images": "node scripts/assets/build-images.mts",
    "assets:logos": "node scripts/assets/build-logo-marks.mts",
    "assets:tools": "node scripts/assets/build-tool-icons.mts",
    "assets:atmosphere": "node scripts/assets/bake-atmosphere.mts",
    "assets:og": "node scripts/assets/build-og-image.mts",
    "perf:budget": "node scripts/perf/check-budgets.mts",
